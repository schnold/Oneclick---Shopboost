# ─────────────────────────────────────────────────────────────────────────────
# Shopboost — environment variables
# Copy to .env and fill in. Everything marked (required) blocks boot if missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shopify app credentials (required)
# `npx shopify app env pull` writes SHOPIFY_API_KEY and SHOPIFY_API_SECRET here
# from the linked app. Run it once after `shopify app config link`.
#
# IMPORTANT: `shopify app dev` injects these into the web process only. The
# worker is a separate process, so they must exist in .env or `npm run worker`
# will refuse to start.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS URL of the deployed app, no trailing slash. (required in prod)
# Not needed for the worker — it uses stored offline tokens and never runs an
# OAuth redirect, so worker/bootstrap.ts supplies a placeholder when unset.
SHOPIFY_APP_URL=https://shopboost.example.com

# Access scopes — must match [access_scopes] in shopify.app.toml. (required)
SCOPES=read_files,read_online_store_pages,read_products,read_themes,write_files,write_products,write_themes

# ── Database (required)
# Postgres. Stores sessions (Prisma session storage), shop settings/knobs,
# audit snapshots, optimization jobs, and before/after records.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/shopboost

# ── Redis (required)
# Backing store for the BullMQ job queue (audits, image compression, SEO/GEO
# writes, speed scans). Use a persistent instance (Upstash/Railway/ElastiCache).
REDIS_URL=redis://default:PASSWORD@HOST:6379

# ── Anthropic (optional — the app works without it)
# Enables AI-written meta titles, descriptions, alt text and product FAQs.
# Without it, SEO copy falls back to a deterministic template generator and the
# FAQ module writes nothing rather than inventing answers.
# From: https://console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# ── Google PageSpeed Insights (optional)
# The API works without a key at a low quota; a key raises it. Without either,
# the speed module still runs its storefront scan and reports "not measured"
# for the Lighthouse score rather than failing.
# Free key: https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# ── Runtime
NODE_ENV=production
# Set to "1" on the machine that runs the BullMQ worker process.
RUN_WORKER=1
